# =============================================================================
# KLIM Integrations - Docker Environment Configuration
# =============================================================================
# Copy this file to .env and configure your environment-specific values
# Never commit .env files with real secrets to version control

# =============================================================================
# VERSION CONTROL
# =============================================================================
VERSION=latest

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
ASPNETCORE_ENVIRONMENT=Production

# =============================================================================
# PORT CONFIGURATION
# =============================================================================
AFFINITY_INTEGRATION_PORT=8088

# =============================================================================
# WEBHOOK CONFIGURATION
# =============================================================================
# SECURITY: Generate a strong random secret for webhook authentication
# 
# Linux/macOS: openssl rand -hex 32
# Windows PowerShell: [System.Web.Security.Membership]::GeneratePassword(64, 16)
# Alternative: Use online generator or password manager
#
# This is REQUIRED - container will fail to start without it
WEBHOOKS__SECRET=your-webhook-secret-here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Azure SQL Database connection string (REQUIRED)
DATABASE__CONNECTIONSTRING=Server=your-server.database.windows.net;Database=your-database;Encrypt=true;TrustServerCertificate=false;Connection Timeout=30;

# Azure AD Authentication (recommended for Azure SQL)
DATABASE__USEAZUREAD=true

# Diagnostics interval in minutes (1-1440)
DATABASE__DIAGNOSTICSINTERVALMINUTES=5

# =============================================================================
# RABBITMQ CONFIGURATION (External Instance - KLIM.Events Standards)
# =============================================================================
# External RabbitMQ Configuration
# Container: competent_burnell (masstransitservices-rabbitmq:latest)
# AMQP: localhost:5672, Management: http://localhost:15672 (guest/guest)
# Exchange: klim.events (clean naming)

# Host Configuration Options:
# - host.docker.internal (for Docker Desktop on Windows/Mac) - RECOMMENDED
# - localhost (if using host networking)
# - 172.17.0.2 (direct container IP)
RABBITMQ__HOST=host.docker.internal
RABBITMQ__USERNAME=guest
RABBITMQ__PASSWORD=guest

# Exchange configuration (clean naming)
RABBITMQ__EXCHANGENAME=klim.events
RABBITMQ__ROUTINGKEYPREFIX=klim.integration

# =============================================================================
# CONSUMER CONFIGURATION
# =============================================================================
# Queue naming follows KLIM standard: {company}.{service}.{purpose}
CONSUMER__QUEUENAME=klim.affinity.sqlwriter
CONSUMER__BINDINGKEY=klim.integration.affinity.#
CONSUMER__PREFETCH=50

# Advanced consumer options (typically use defaults)
CONSUMER__DURABLE=true
CONSUMER__AUTODELETE=false

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOGGING__LOGLEVEL__DEFAULT=Information
LOGGING__LOGLEVEL__MICROSOFT=Warning
LOGGING__LOGLEVEL__MASSTRANSIT=Information

# =============================================================================
# CROSS-PLATFORM TESTING COMMANDS
# =============================================================================
# Test RabbitMQ connectivity after configuration:
#
# Linux/macOS:
# ./test-rabbitmq.sh
# curl -u guest:guest http://localhost:15672/api/overview
#
# Windows PowerShell:
# .\test-rabbitmq.ps1
# $cred = [System.Convert]::ToBase64String([System.Text.Encoding]::ASCII.GetBytes("guest:guest"))
# Invoke-RestMethod -Uri "http://localhost:15672/api/overview" -Headers @{Authorization = "Basic $cred"}
#
# Test health endpoint:
# Linux/macOS: curl http://localhost:8088/health
# Windows PowerShell: Invoke-RestMethod -Uri "http://localhost:8088/health"

# =============================================================================
# DEVELOPMENT EXAMPLES
# =============================================================================
# For development environment with debug logging:
# ASPNETCORE_ENVIRONMENT=Development
# LOGGING__LOGLEVEL__DEFAULT=Debug
# LOGGING__LOGLEVEL__MASSTRANSIT=Debug

# For testing with different queue names:
# CONSUMER__QUEUENAME=klim.affinity.sqlwriter.test
# RABBITMQ__EXCHANGENAME=klim.events.test

# For performance testing:
# CONSUMER__PREFETCH=100
# DATABASE__DIAGNOSTICSINTERVALMINUTES=1

# =============================================================================
# SECURITY NOTES
# =============================================================================
# - Never commit real secrets to version control
# - Use Azure Key Vault or similar for production secrets
# - Rotate webhook secrets regularly
# - Use strong passwords for RabbitMQ in production
# - Enable TLS/SSL for all external connections in production

# =============================================================================
# NETWORK TROUBLESHOOTING
# =============================================================================
# If containers cannot connect to RabbitMQ, try these options in order:
# 1. host.docker.internal (recommended for Docker Desktop)
# 2. localhost (if using --network host)
# 3. 172.17.0.2 (direct container IP from docker inspect)
# 4. competent_burnell (container name, requires shared network)
#
# Verify RabbitMQ connectivity:
# 
# Linux/macOS:
# curl -u guest:guest http://localhost:15672/api/overview
# docker exec klim-affinity-integration nc -zv host.docker.internal 5672
#
# Windows PowerShell:
# $cred = [System.Convert]::ToBase64String([System.Text.Encoding]::ASCII.GetBytes("guest:guest"))
# Invoke-RestMethod -Uri "http://localhost:15672/api/overview" -Headers @{Authorization = "Basic $cred"}
# Test-NetConnection -ComputerName localhost -Port 5672
# docker exec klim-affinity-integration powershell -Command "Test-NetConnection -ComputerName host.docker.internal -Port 5672"

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# For high-throughput scenarios:
# CONSUMER__PREFETCH=200
# DATABASE__DIAGNOSTICSINTERVALMINUTES=10
#
# For low-latency scenarios:
# CONSUMER__PREFETCH=10
# DATABASE__DIAGNOSTICSINTERVALMINUTES=1
#
# For development/testing:
# CONSUMER__PREFETCH=1
# LOGGING__LOGLEVEL__DEFAULT=Debug

# =============================================================================
# POWERSHELL-SPECIFIC HELPERS
# =============================================================================
# Generate webhook secret in PowerShell:
# [System.Web.Security.Membership]::GeneratePassword(64, 16)
#
# Test webhook endpoint in PowerShell:
# $body = @{
#     type = "organization.created"
#     affinityOrganizationId = 123456
#     name = "Test Organization"
#     domain = "test.com"
# } | ConvertTo-Json
# Invoke-RestMethod -Uri "http://localhost:8088/webhooks/affinity/your-secret" -Method POST -ContentType "application/json" -Body $body
#
# Check Docker containers in PowerShell:
# docker ps | Select-String rabbitmq
#
# View logs in PowerShell:
# docker-compose logs --tail=50 | Select-String -Pattern "error|warning" -CaseSensitive:$false