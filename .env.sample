# Affinity webhook secret (path-bound)
AFFINITY_WEBHOOK_SECRET=REPLACE_WITH_SECRET

# Standardized Database Configuration (aligned with KLIM.Events)
DATABASE__CONNECTIONSTRING=Server=tcp:YOUR-SERVER.database.windows.net,1433;Database=YOUR-DB;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;Authentication=Active Directory Default
DATABASE__USEAZUREAD=true
DATABASE__DIAGNOSTICSINTERVALMINUTES=5

# RabbitMQ defaults (override as needed)
RABBITMQ__HOST=rabbitmq
RABBITMQ__USERNAME=guest
RABBITMQ__PASSWORD=guest

# Consumer Configuration (CORRECTED: Following KLIM.Events naming standards)
CONSUMER__QUEUENAME=klim.affinity.sqlwriter
CONSUMER__BINDINGKEY=klim.integration.affinity.#
CONSUMER__PREFETCH=50